# Miriel AI Integration
# Get your API key at https://miriel.ai
MIRIEL_API_KEY=your_api_key_here
MIRIEL_API_URL=https://api.prod.miriel.ai
MIRIEL_AUTO_LEARNING=true

# Gemini — scene image generation (text generation stays on Miriel)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Image model used to render scenes (GA "Nano Banana").
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Aspect ratio for generated scenes.
GEMINI_IMAGE_ASPECT_RATIO=16:9
# Reserved: text model for any future Gemini-authored text (Miriel is primary).
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
